---
layout: base.njk
title: Blog
description: Analysis on scientific writing, peer review and biotech communication.
pagination:
  data: collections.posts
  size: 6
  alias: pagePosts
permalink: "/blog/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---
<div class="panel bg-down panel-with-footer blog-index-panel">
  <div class="panel-inner">

    <div class="eyebrow">Blog</div>
    <h1>Where scientific communication breaks down — and how to fix it</h1>
    <p class="lede">Analysis on scientific writing, peer review and biotech communication, from the team behind Iridis.</p>

    <!-- Search + topic filter -->
    <div class="blog-controls">
      <div class="blog-search">
        <span class="blog-search-icon" aria-hidden="true">⌕</span>
        <input type="search" id="blogSearch" class="blog-search-input" placeholder="Search posts…" aria-label="Search posts">
      </div>
      <div class="blog-topics" id="blogTopics" role="group" aria-label="Filter by topic">
        <button class="filter-chip" aria-pressed="true" data-topic="all">All topics</button>
        {% for tag in collections.postTags %}
        <button class="filter-chip" aria-pressed="false" data-topic="{{ tag }}">{{ tag }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- DEFAULT (paginated) grid — shown when no search/filter is active -->
    <div class="blog-grid" id="blogGridPaged">
      {% for post in pagePosts %}
      <a class="blog-card-link" href="{{ post.url }}">
        <article class="blog-card">
          {% if post.data.cover %}
          <div class="blog-head has-cover" style="background-image:url('{{ post.data.cover }}')"></div>
          {% else %}
          <div class="blog-head blog-head-fallback">
            <img class="blog-head-mark" src="/images/mark-dark-bg.png" alt="">
            <span class="tag">{{ post.data.tags[0] }}</span>
          </div>
          {% endif %}
          <div class="blog-body">
            <div class="blog-meta">{{ post.data.date | readableDate }}{% if post.data.readingTime %} · {{ post.data.readingTime }} min{% endif %}</div>
            <h3>{{ post.data.title }}</h3>
            <p>{{ post.data.excerpt }}</p>
          </div>
        </article>
      </a>
      {% endfor %}
    </div>

    <!-- Pagination (hidden while searching/filtering) -->
    {% if pagination.pages.length > 1 %}
    <nav class="blog-pagination" id="blogPagination" aria-label="Blog pages">
      {% if pagination.href.previous %}<a class="blog-page-arrow" href="{{ pagination.href.previous }}" aria-label="Previous page">‹</a>{% else %}<span class="blog-page-arrow disabled">‹</span>{% endif %}
      {%- for pageUrl in pagination.hrefs -%}
        <a class="blog-page-num{% if page.url == pageUrl %} active{% endif %}" href="{{ pageUrl }}">{{ loop.index }}</a>
      {%- endfor -%}
      {% if pagination.href.next %}<a class="blog-page-arrow" href="{{ pagination.href.next }}" aria-label="Next page">›</a>{% else %}<span class="blog-page-arrow disabled">›</span>{% endif %}
    </nav>
    {% endif %}

    <!-- SEARCH RESULTS grid — populated by JS from the full post index -->
    <div class="blog-grid" id="blogGridResults" hidden></div>
    <p class="blog-noresults" id="blogNoResults" hidden>No posts match your search.</p>

    <!-- Full post index (all posts) as data for client-side search/filter -->
    <script id="blogData" type="application/json">
    [
      {%- for post in collections.posts -%}
      {
        "url": "{{ post.url }}",
        "title": {{ post.data.title | dump | safe }},
        "excerpt": {{ post.data.excerpt | dump | safe }},
        "date": "{{ post.data.date | readableDate }}",
        "readingTime": {{ post.data.readingTime or 0 }},
        "tags": {{ post.data.tags | dump | safe }},
        "cover": "{{ post.data.cover }}"
      }{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ]
    </script>

  </div>
  <div class="panel-footer-bar">
    <div class="f-brand">
      <img src="/images/mark-dark-bg.png" alt="">
      <span class="f-wm">IRIDIS</span>
    </div>
    <div>© 2026 Iridis · Scientific writing with structural clarity</div>
  </div>
</div>

<script>
(function () {
  const dataEl = document.getElementById('blogData');
  if (!dataEl) return;
  let data = [];
  try { data = JSON.parse(dataEl.textContent); } catch (e) { return; }

  const search     = document.getElementById('blogSearch');
  const topics     = document.getElementById('blogTopics');
  const paged      = document.getElementById('blogGridPaged');
  const pagination = document.getElementById('blogPagination');
  const results    = document.getElementById('blogGridResults');
  const noResults  = document.getElementById('blogNoResults');

  let topic = 'all';
  let query = '';

  function esc(s) { return String(s == null ? '' : s); }

  function cardHTML(p) {
    const head = p.cover
      ? '<div class="blog-head has-cover" style="background-image:url(\'' + esc(p.cover) + '\')"></div>'
      : '<div class="blog-head blog-head-fallback"><img class="blog-head-mark" src="/images/mark-dark-bg.png" alt=""><span class="tag">' + esc((p.tags || [])[0]) + '</span></div>';
    const meta = esc(p.date) + (p.readingTime ? ' · ' + p.readingTime + ' min' : '');
    return '<a class="blog-card-link" href="' + esc(p.url) + '"><article class="blog-card">' + head +
      '<div class="blog-body"><div class="blog-meta">' + meta + '</div><h3>' + esc(p.title) + '</h3><p>' + esc(p.excerpt) + '</p></div></article></a>';
  }

  function isActive() { return topic !== 'all' || query.trim() !== ''; }

  function apply() {
    if (!isActive()) {
      paged.hidden = false;
      paged.style.display = '';
      if (pagination) pagination.style.display = '';
      results.hidden = true;
      results.style.display = 'none';
      noResults.hidden = true;
      noResults.style.display = 'none';
      results.innerHTML = '';
      return;
    }
    const q = query.trim().toLowerCase();
    const filtered = data.filter(function (p) {
      const okTopic = topic === 'all' || (p.tags || []).indexOf(topic) !== -1;
      const hay = (esc(p.title) + ' ' + esc(p.excerpt) + ' ' + (p.tags || []).join(' ')).toLowerCase();
      const okQuery = !q || hay.indexOf(q) !== -1;
      return okTopic && okQuery;
    });
    paged.hidden = true;
    paged.style.display = 'none';
    if (pagination) pagination.style.display = 'none';
    results.innerHTML = filtered.map(cardHTML).join('');
    results.hidden = filtered.length === 0;
    results.style.display = filtered.length === 0 ? 'none' : '';
    noResults.hidden = filtered.length !== 0;
    noResults.style.display = filtered.length !== 0 ? 'none' : '';
  }

  if (search) search.addEventListener('input', function () { query = search.value; apply(); });
  if (topics) topics.querySelectorAll('.filter-chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      topics.querySelectorAll('.filter-chip').forEach(function (c) {
        c.setAttribute('aria-pressed', String(c === chip));
      });
      topic = chip.dataset.topic;
      apply();
    });
  });
})();
</script>
