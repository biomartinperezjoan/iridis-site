<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}{% if title %} · {% endif %}Iridis</title>
<meta name="description" content="{{ excerpt or description or 'Scientific writing with structural clarity. Iridis writes, edits and validates scientific communication for researchers, biotech teams and digital health companies.' }}">
<link rel="canonical" href="https://iridiswriting.com{{ page.url }}">
<meta property="og:type" content="article">
<meta property="og:url" content="https://iridiswriting.com{{ page.url }}">
<meta property="og:title" content="{{ title }} · Iridis">
<meta property="og:description" content="{{ excerpt or description or 'Scientific writing with structural clarity.' }}">
<meta property="og:image" content="https://iridiswriting.com/images/mark-light-bg.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<!-- ═════════ NAV ═════════ -->
<nav class="nav" aria-label="Main">
  <a class="nav-brand" href="/" aria-label="Iridis, home">
    <img src="/images/mark-dark-bg.png" alt="">
    <span class="wm">IRIDIS</span>
  </a>
  <ul class="nav-tabs" id="navTabs" role="tablist">
    <li><a href="/#home"{% if page.url == '/' %} aria-selected="true"{% endif %}>Home</a></li>
    <li><a href="/#services">Services</a></li>
    <li><a href="/work/"{% if page.url.startsWith('/work/') %} aria-selected="true"{% endif %}>Work</a></li>
    <li><a href="/#about"{% if page.url.startsWith('/about/') %} aria-selected="true"{% endif %}>About</a></li>
    <li><a href="/blog/"{% if page.url.startsWith('/blog/') %} aria-selected="true"{% endif %}>Blog</a></li>
    <li><a href="/#contact">Contact</a></li>
  </ul>
  <a class="nav-cta" href="/#contact">Tell us about your project</a>
  <button class="nav-toggle" id="navToggle" aria-label="Open menu">☰</button>
</nav>

<main>
{{ content | safe }}
</main>

<script src="/js/nav.js"></script>
</body>
</html>
