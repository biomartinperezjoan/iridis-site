<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}{% if title %} · {% endif %}Iridis</title>
<meta name="description" content="{{ description or 'Scientific writing with structural clarity.' }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<!-- ═════════ NAV ═════════ -->
<nav class="nav" aria-label="Main">
  <a class="nav-brand" href="/" aria-label="Iridis, home">
    <img src="/images/mark-dark-bg.png" alt="">
    <span class="wm">IRIDIS</span>
  </a>
  <ul class="nav-tabs" id="navTabs" role="tablist">
    <li><a href="/#home">Home</a></li>
    <li><a href="/#services">Services</a></li>
    <li><a href="/#work">Work</a></li>
    <li><a href="/#about">About</a></li>
    <li><a href="/blog/" aria-selected="true">Blog</a></li>
    <li><a href="/#contact">Contact</a></li>
  </ul>
  <a class="nav-cta" href="/#contact">Tell us about your project</a>
  <button class="nav-toggle" id="navToggle" aria-label="Open menu">☰</button>
</nav>

<main>
{{ content | safe }}
</main>

<!-- ═════════ FOOTER ═════════ -->
<footer class="footer">
  <div class="footer-inner">
    <div>
      <div class="f-brand">
        <img src="/images/mark-dark-bg.png" alt="">
        <span class="f-wm">IRIDIS</span>
      </div>
      <div>Scientific writing with structural clarity.</div>
    </div>
    <div style="text-align:right">
      <div>© {{ site.year }} Iridis</div>
      <div style="margin-top:4px">The colour is in the structure, not the surface.</div>
    </div>
  </div>
</footer>

<script src="/js/nav.js"></script>
</body>
</html>
