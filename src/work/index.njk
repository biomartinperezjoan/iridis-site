---
layout: base.njk
title: Work
description: Selected scientific and medical writing projects across publications, funding, content and science validation.
permalink: "/work/index.html"
---
{% set lineMap = {
  "Publication support": "publications",
  "Funding & grant writing": "funding",
  "Content & medcomms": "content",
  "Science validation": "validation"
} %}

<style>
/* ═══════════════ WORK PAGE — self-contained styles ═══════════════
   All Work-page layout lives here so styles.css stays untouched.
   Pagination is client-side: 6 cards/page on tall screens, 3 on short.
   ================================================================= */

/* PANEL 1 — fill the viewport below the fixed nav (panel 2 must not peek) */
#workPanel1.panel {
  justify-content: center;
  min-height: 100svh;
  margin-top: 0;
  padding-top: calc(var(--nav-h) + var(--sp-2));
  padding-bottom: var(--sp-16);
  box-sizing: border-box;
}
#workPanel1 .panel-inner { flex: none; justify-content: center; padding: 0; }
#workPanel1 .eyebrow { margin-bottom: var(--sp-4); }
#workPanel1 h1 { margin-bottom: var(--sp-3); }
#workPanel1 .work-lede { margin-bottom: var(--sp-4); max-width: 72ch; }

/* Filter chips row */
#workPanel1 .work-filters {
  display: flex; flex-wrap: wrap; gap: var(--sp-2);
  margin: var(--sp-3) 0 var(--sp-5);
}

/* GRID — fixed-height cards so every card is identical */
#workPanel1 .work-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-auto-rows: 255px;
  gap: var(--sp-5);
  margin: 0;
}
#workPanel1 .work-grid[hidden] { display: none; }

#workPanel1 .work-card-link { display: block; height: 255px; text-decoration: none; color: inherit; }
#workPanel1 .work-card {
  height: 2255px;
  display: flex; flex-direction: column;
  background: #fff; border: 1px solid var(--mist); border-radius: var(--r-lg);
  overflow: hidden;
  transition: border-color .15s, transform .15s, box-shadow .15s;
}
#workPanel1 .work-card-link:hover .work-card {
  border-color: var(--pinion);
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(30,106,78,.12);
}
#workPanel1 .work-card .work-head { height: 4px; flex: none; background: var(--pinion); }
#workPanel1 .work-card .work-body {
  flex: 1; min-height: 0;
  display: flex; flex-direction: column; gap: var(--sp-3);
  padding: var(--sp-6) var(--sp-6) var(--sp-6); overflow: hidden;
}
#workPanel1 .work-card .work-kicker {
  flex: none;
  font-family: var(--sans-display); font-size: 11px; font-weight: 700;
  letter-spacing: .15em; text-transform: uppercase; color: var(--slate);
}
#workPanel1 .work-card h3 {
  flex: none; margin: 0; color: var(--ink); line-height: 1.25;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
#workPanel1 .work-card .work-summary {
  flex: none; margin: 0; font-size: var(--fs-body); line-height: 1.55; color: var(--slate);
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
#workPanel1 .work-card .work-meta {
  flex: none; margin-top: auto; padding-top: var(--sp-2);
  display: flex; flex-wrap: wrap; gap: var(--sp-2);
  max-height: 70px; overflow: hidden; align-content: flex-start;
}
#workPanel1 .work-card .work-meta span {
  font-family: var(--sans-body); font-size: 11.5px; color: var(--slate);
  background: var(--down); border-radius: var(--r-sm); padding: 2px 8px;
}

/* Pagination */
#workPanel1 .work-pagination {
  display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
  margin-top: var(--sp-6);
}
#workPanel1 .work-pagination[hidden] { display: none; }
#workPanel1 .pg-num, #workPanel1 .pg-arrow {
  font-family: var(--sans-display); font-weight: 700; font-size: 14px;
  min-width: 38px; height: 38px; padding: 0 10px;
  display: inline-flex; align-items: center; justify-content: center;
  border: 1px solid var(--mist); border-radius: var(--r-sm);
  background: #fff; color: var(--slate); text-decoration: none; cursor: pointer;
  transition: background .15s, color .15s, border-color .15s;
}
#workPanel1 .pg-num:hover, #workPanel1 .pg-arrow:hover { border-color: var(--pinion); color: var(--pinion); }
#workPanel1 .pg-num.active { background: var(--pinion); color: var(--down); border-color: var(--pinion); }
#workPanel1 .pg-arrow.disabled { opacity: .4; pointer-events: none; }

#workPanel1 .work-noresults { text-align: center; color: var(--slate); font-size: 15px; padding: var(--sp-10) 0; }
#workPanel1 .work-noresults[hidden] { display: none; }

/* Side dots + down-arrow (desktop only) */
.work-dots, .work-down { display: none; }
.work-dots.on, .work-down.on { display: flex; }
.work-dots {
  position: fixed; right: var(--sp-5); top: 50%; transform: translateY(-50%); z-index: 90;
  flex-direction: column; align-items: center; gap: 12px;
  padding: 14px 9px; border-radius: 999px;
  border: 1px solid rgba(20,36,29,.12); background: rgba(255,255,255,.78); backdrop-filter: blur(6px);
}
.work-dots .dot {
  width: 9px; height: 9px; border-radius: 50%;
  border: 1.5px solid rgba(90,103,95,.4); background: transparent; cursor: pointer; padding: 0;
  transition: background .2s, border-color .2s, transform .2s;
}
.work-dots .dot:hover { border-color: var(--pinion); }
.work-dots .dot.active { background: var(--pinion); border-color: var(--pinion); transform: scale(1.25); }
.work-down {
  position: fixed; bottom: var(--sp-6); left: 50%; transform: translateX(-50%); z-index: 90;
  align-items: center; justify-content: center;
  width: 42px; height: 42px; border-radius: 50%;
  border: 1px solid rgba(20,36,29,.12); background: rgba(255,255,255,.78); backdrop-filter: blur(6px);
  color: var(--ink); cursor: pointer;
  transition: opacity .25s, background .15s; animation: workbob 2.2s ease-in-out infinite;
}
.work-down:hover { background: var(--pinion); color: var(--down); }
.work-down.is-last { opacity: 0; pointer-events: none; }
@keyframes workbob {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-5px); }
}

/* Publications panel list */
#workPanel2 .pub-list { list-style: none; margin: var(--sp-6) 0 0; padding: 0; }
#workPanel2 .pub-list li {
  display: flex; gap: var(--sp-5); padding: var(--sp-4) 0;
  border-top: 1px solid var(--mist); font-size: 14.5px; line-height: 1.6; color: var(--slate);
}
#workPanel2 .pub-list li:last-child { border-bottom: 1px solid var(--mist); }
#workPanel2 .pub-year { font-family: var(--sans-display); font-weight: 700; color: var(--ink); min-width: 56px; }
#workPanel2 .pub-src { color: var(--ink); font-style: italic; }
#workPanel2 .work-cta { margin-top: var(--sp-8); }

/* Responsive */
@media (min-width: 861px) and (max-width: 1040px) {
  #workPanel1 .work-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 860px) {
  #workPanel1.panel { min-height: 0; padding-top: calc(var(--nav-h) + var(--sp-6)); }
  #workPanel1 .work-grid { grid-template-columns: 1fr; grid-auto-rows: auto; gap: var(--sp-4); }
  #workPanel1 .work-card-link, #workPanel1 .work-card { height: auto; }
  #workPanel1 .work-card .work-meta { max-height: none; }
  .work-dots, .work-down { display: none !important; }
}
</style>

<!-- ═════════ PANEL 1 · SELECTED WORK ═════════ -->
<div class="panel bg-down" id="workPanel1">
  <div class="panel-inner">

    <div class="eyebrow">{{ workPage.eyebrow }}</div>
    <h1>{{ workPage.title }}</h1>
    <p class="lede work-lede">{{ workPage.lede }}</p>

    <div class="work-filters" id="workTopics" role="group" aria-label="Filter by service line">
      <button class="filter-chip" aria-pressed="true" data-topic="all">All</button>
      <button class="filter-chip" aria-pressed="false" data-topic="publications">Publication support</button>
      <button class="filter-chip" aria-pressed="false" data-topic="funding">Funding &amp; grant writing</button>
      <button class="filter-chip" aria-pressed="false" data-topic="content">Content &amp; medcomms</button>
      <button class="filter-chip" aria-pressed="false" data-topic="validation">Science validation</button>
    </div>

    <!-- Cards rendered here by JS -->
    <div class="work-grid" id="workGrid"></div>
    <p class="work-noresults" id="workNoResults" hidden>No cases in this category yet.</p>

    <!-- Pagination rendered here by JS -->
    <nav class="work-pagination" id="workPagination" aria-label="Work pages" hidden></nav>

    <!-- Full case index for client-side pagination + filtering -->
    <script id="workData" type="application/json">
    [
      {%- for case in collections.cases -%}
      {
        "url": "/work/{{ case.fileSlug }}/",
        "title": {{ case.data.title | dump | safe }},
        "summary": {{ case.data.summary | dump | safe }},
        "line": {{ case.data.line | dump | safe }},
        "lineKey": "{{ lineMap[case.data.line] }}",
        "format": {{ case.data.format | dump | safe }},
        "area": {{ (case.data.area or "") | dump | safe }},
        "year": {{ (case.data.year or "") | dump | safe }}
      }{% if not loop.last %},{% endif %}
      {%- endfor -%}
    ]
    </script>

  </div>
</div>

<!-- ═════════ PANEL 2 · PEER-REVIEWED PUBLICATIONS ═════════ -->
<div class="panel bg-white panel-with-footer" id="workPanel2">
  <div class="panel-inner">
    <div class="eyebrow">{{ workPage.publications.eyebrow }}</div>
    <h2>{{ workPage.publications.title }}</h2>
    <p class="lede">{{ workPage.publications.lede }}</p>
    <ul class="pub-list">
      <li><span class="pub-year">202X</span><span>Author A, Author B, et al. Title of the publication pending. <span class="pub-src">Journal Name.</span> DOI pending.</span></li>
      <li><span class="pub-year">202X</span><span>Author C, Author D, et al. Title of the publication pending. <span class="pub-src">Journal Name.</span> DOI pending.</span></li>
      <li><span class="pub-year">202X</span><span>Author E, et al. Title of the publication pending. <span class="pub-src">Journal Name.</span> DOI pending.</span></li>
    </ul>
    <div class="work-cta">
      <a class="btn btn-secondary" href="/#contact">Ask for references</a>
    </div>
  </div>
  <div class="panel-footer-bar">
    <div class="f-brand"><img src="/images/mark-dark-bg.png" alt=""> <span class="f-wm">IRIDIS</span></div>
    <div>© 2026 Iridis · Scientific writing with structural clarity</div>
  </div>
</div>

<!-- Side dots + down-arrow -->
<div class="work-dots" id="workDots" aria-hidden="true"></div>
<button class="work-down" id="workDown" aria-label="Next section" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
</button>

<script>
/* ── Client-side paginate + filter (6/page tall screens, 3/page short) ── */
(function () {
  const dataEl = document.getElementById('workData');
  if (!dataEl) return;
  let all = [];
  try { all = JSON.parse(dataEl.textContent); } catch (e) { return; }

  const grid      = document.getElementById('workGrid');
  const pager      = document.getElementById('workPagination');
  const noResults  = document.getElementById('workNoResults');
  const topics     = document.getElementById('workTopics');

  let topic = 'all';
  let pageIndex = 0;

  function perPage() {
    // 3 per page when the viewport is short OR narrow (one column),
    // 6 per page on roomy screens.
    if (window.innerWidth <= 860) return 3;
    if (window.innerHeight <= 880) return 3;
    return 6;
  }

  function filtered() {
    return topic === 'all' ? all : all.filter(c => c.lineKey === topic);
  }

  function esc(s) { return String(s == null ? '' : s); }

  function cardHTML(c) {
    let meta = '<span>' + esc(c.format) + '</span>';
    if (c.area) meta += '<span>' + esc(c.area) + '</span>';
    if (c.year) meta += '<span>' + esc(c.year) + '</span>';
    return '<a class="work-card-link" href="' + esc(c.url) + '">' +
      '<article class="work-card"><div class="work-head"></div>' +
      '<div class="work-body"><span class="work-kicker">' + esc(c.line) + '</span>' +
      '<h3>' + esc(c.title) + '</h3><p class="work-summary">' + esc(c.summary) + '</p>' +
      '<div class="work-meta">' + meta + '</div></div></article></a>';
  }

  function render() {
    const items = filtered();
    const pp = perPage();
    const pageCount = Math.max(1, Math.ceil(items.length / pp));
    if (pageIndex >= pageCount) pageIndex = pageCount - 1;
    if (pageIndex < 0) pageIndex = 0;

    // Cards for the current page
    const start = pageIndex * pp;
    const slice = items.slice(start, start + pp);

    if (items.length === 0) {
      grid.hidden = true; grid.innerHTML = '';
      noResults.hidden = false;
      pager.hidden = true; pager.innerHTML = '';
      return;
    }
    noResults.hidden = true;
    grid.hidden = false;
    grid.innerHTML = slice.map(cardHTML).join('');

    // Pagination controls — always shown (even a single page renders "1"),
    // so the controls don't vanish when a filter narrows results to one page.
    pager.hidden = false;
    let html = '';
    html += pageIndex === 0
      ? '<span class="pg-arrow disabled">‹</span>'
      : '<button class="pg-arrow" data-go="' + (pageIndex - 1) + '" aria-label="Previous page">‹</button>';
    for (let p = 0; p < pageCount; p++) {
      html += '<button class="pg-num' + (p === pageIndex ? ' active' : '') + '" data-go="' + p + '">' + (p + 1) + '</button>';
    }
    html += pageIndex === pageCount - 1
      ? '<span class="pg-arrow disabled">›</span>'
      : '<button class="pg-arrow" data-go="' + (pageIndex + 1) + '" aria-label="Next page">›</button>';
    pager.innerHTML = html;

    pager.querySelectorAll('[data-go]').forEach(btn => {
      btn.addEventListener('click', () => {
        pageIndex = parseInt(btn.dataset.go, 10);
        render();
        document.getElementById('workPanel1').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  }

  // Filter chips
  if (topics) topics.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      topics.querySelectorAll('.filter-chip').forEach(c => c.setAttribute('aria-pressed', String(c === chip)));
      topic = chip.dataset.topic;
      pageIndex = 0;
      render();
    });
  });

  // Re-paginate if per-page count changes on resize
  let lastPP = perPage();
  window.addEventListener('resize', () => {
    const now = perPage();
    if (now !== lastPP) { lastPP = now; pageIndex = 0; render(); }
  });

  render();
})();

/* ── Panel scroll-nav: side dots + down arrow (desktop only) ── */
(function () {
  if (window.innerWidth <= 860) return;
  const panels = Array.from(document.querySelectorAll('.panel'));
  const dotsEl = document.getElementById('workDots');
  const downBtn = document.getElementById('workDown');
  if (!dotsEl || panels.length <= 1) return;

  let activeIndex = 0, wheelLock = false;

  dotsEl.classList.add('on');
  downBtn.classList.add('on');
  panels.forEach((p, i) => {
    const dot = document.createElement('button');
    dot.className = 'dot' + (i === 0 ? ' active' : '');
    dot.setAttribute('aria-label', 'Go to section ' + (i + 1));
    dot.addEventListener('click', () => goToPanel(i));
    dotsEl.appendChild(dot);
  });

  function goToPanel(i) {
    activeIndex = Math.max(0, Math.min(panels.length - 1, i));
    panels[activeIndex].scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      activeIndex = panels.indexOf(e.target);
      dotsEl.querySelectorAll('.dot').forEach((d, i) => d.classList.toggle('active', i === activeIndex));
      downBtn.classList.toggle('is-last', activeIndex === panels.length - 1);
    });
  }, { threshold: 0.55 });
  panels.forEach(p => obs.observe(p));

  downBtn.addEventListener('click', () => goToPanel(activeIndex + 1));

  window.addEventListener('wheel', (e) => {
    if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
    if (e.ctrlKey) return;
    const cur = panels[activeIndex];
    if (cur && cur.scrollHeight > window.innerHeight + 4) {
      const r = cur.getBoundingClientRect();
      if (e.deltaY > 0 && r.bottom > window.innerHeight + 4) return;
      if (e.deltaY < 0 && r.top < -4) return;
    }
    e.preventDefault();
    if (wheelLock) return;
    wheelLock = true; setTimeout(() => { wheelLock = false; }, 700);
    goToPanel(activeIndex + (e.deltaY > 0 ? 1 : -1));
  }, { passive: false });

  window.addEventListener('keydown', (e) => {
    if (['ArrowDown', 'PageDown'].includes(e.key)) { e.preventDefault(); goToPanel(activeIndex + 1); }
    else if (['ArrowUp', 'PageUp'].includes(e.key)) { e.preventDefault(); goToPanel(activeIndex - 1); }
  });
})();
</script>
